{
  "name": "dial",
  "version": "0.0.2",
  "description": "a little radio chat you ssh into. turn the dial, hear who's near you.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "esbuild server.js --bundle --platform=node --target=node18 --outfile=dist/dial.js && node -e \"const fs=require('fs'),v=require('./package.json').version;fs.copyFileSync('dist/dial.js','dist/dial-'+v+'.js')\""
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "ssh2": "^1.16.0"
  },
  "allowScripts": {
    "ssh2@1.17.0": true
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
